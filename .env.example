NEXT_PUBLIC_STRATEGY_CALL_URL=https://calendly.com/hello-opzix
NEXT_PUBLIC_SITE_URL=https://opzix.io

# Supabase.
# SUPABASE_SERVICE_ROLE_KEY is server-only and must never be exposed to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Explicit invite target. Add this exact URL to Supabase Auth's redirect allowlist.
OPZIX_AUTH_REDIRECT_URL=https://opzix.io/accept-invite
# Server-only internal admin passcode; use a unique production value.
OPZIX_ADMIN_PASSCODE=replace-with-long-random-passcode
# Used only for secure resend fallback emails sent through the Resend API.
RESEND_API_KEY=
OPZIX_AUTH_FROM_EMAIL="Opzix <accounts@opzix.io>"
# Required in production. Use a dedicated random secret for activation-code HMACs.
OPZIX_ACTIVATION_CODE_SECRET=replace-with-long-random-secret

# Server-only PRD-016 QA customer seeding.
# Leave disabled in production unless intentionally running the protected seed.
OPZIX_QA_SEEDING_ENABLED=false
QA_AGENT_A_EMAIL=
QA_AGENT_B_EMAIL=
QA_AGENT_A_PASSWORD=
QA_AGENT_B_PASSWORD=
OPZIX_QA_SEND_INVITES=false

# Server-only MLS Grid provider access. Do not expose these through NEXT_PUBLIC_*.
MLS_GRID_BASE_URL=https://api.mlsgrid.com/v2
MLS_GRID_ORIGINATING_SYSTEM_NAME=carolina
MLS_GRID_IDX_ACCESS_TOKEN=
MLS_GRID_BO_ACCESS_TOKEN=

# Google Ads conversion tracking.
# Use the AW ID from Google Ads, for example AW-XXXXXXXXXX.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
# Fill these with the real Google Ads conversion labels when they are created.
NEXT_PUBLIC_GOOGLE_ADS_AUDIT_STARTED_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_STRATEGY_CALL_BOOKED_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_FORM_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_AUDIT_COMPLETED_LABEL=

# Founder dashboard / Zora intelligence.
ZORA_PROMPT_VERSION=zora-founder-intelligence-2026-07-16
ZORA_CONVERSATION_FLOW_VERSION=guided-qualification-v1
ZORA_EXPERIMENT_ID=
ZORA_REVIEW_MODEL=gpt-4o-mini

# Optional session replay preparation. A replay link is only shown after a
# visitor/session replay identifier is captured and correlated.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
CLARITY_PROJECT_ID=

# Server-only Google Calendar OAuth.
# Use a plain string for GOOGLE_OAUTH_REDIRECT_URI, not JSON or brackets.
GOOGLE_OAUTH_SETUP_SECRET=replace-with-random-setup-secret
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REFRESH_TOKEN=replace-with-google-refresh-token
GOOGLE_OAUTH_REDIRECT_URI=https://opzix.io/api/google/oauth/callback
GOOGLE_CALENDAR_ID=hello@opzix.io
GOOGLE_CALENDAR_TIMEZONE=America/New_York
GOOGLE_CALENDAR_CREATE_MEET_LINK=true

# Server-only. Keep false on Vercel Hobby because hourly cron schedules are not supported.
APPOINTMENT_REMINDERS_ENABLED=false
